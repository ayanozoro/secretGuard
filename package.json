{
  "name": "secretguard",
  "version": "1.0.0",
  "description": "SecretGuard - Secret Leak Intelligence & Prevention Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "scan": "node packages/scanner/src/index.js",
    "test": "node tests/unit/runTests.js",
    "seed": "node packages/database/src/seeds/seed.js",
    "api:start": "node apps/api/src/server.js",
    "api:dev": "node --watch apps/api/src/server.js",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build"
  },
  "keywords": [
    "cybersecurity",
    "secret-scanner",
    "credential-leak",
    "security-analysis",
    "devsecops"
  ],
  "author": "SecretGuard Team",
  "license": "Apache-2.0",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  }
}
